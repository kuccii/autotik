REGION=FR
TIKTOK_ACCOUNT=@yourhandle
TIKTOK_EMAIL=you@example.com
TIKTOK_PASSWORD=replace-me
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openrouter/free
N8N_WEBHOOK_URL=https://n8n.qivook.com/webhook/autotik-alert
DISCOVER_FETCH=40
DISCOVER_KEEP=12
# Primary discovery: TikTok hashtag feeds, paged with a cursor. The tag is the
# niche and each video keeps a genuine source region, so this targets the
# audience far better than region feeds do.
DISCOVER_HASHTAGS=humour,mdr,rire,drole,blague,comedie,humourfrancais,francetok,sketch,extrait,scene,cinema,film,serie,funny,comedy,britishcomedy,ukcomedy,prank,standup
DISCOVER_HASHTAG_PAGES=3
# Fallback used only when every hashtag fails: generic region feed.
DISCOVER_REGIONS=FR,GB,BE,CH
# Hard source-region gate. Region feeds are not really regional (asking for
# FR/GB returned 16 countries), and hashtag feeds still skew US, so the target
# markets must be stated explicitly. Empty means no gate.
DISCOVER_ALLOW_REGIONS=FR,GB,BE,CH,CA,IE,AU
DISCOVER_MAX_AGE_DAYS=14
# Measured 2026-11-09: at >=500k likes every remaining candidate was US and
# French creators on FR comedy tags top out near 230k, so 500k produced zero
# French content. 100k reliably yields FR + UK candidates.
DISCOVER_MIN_LIKES=100000
# Caption keyword gate for the region-feed fallback only; hashtags define the
# niche on the primary path.
DISCOVER_KEYWORDS=funny,comedy,humour,humor,drole,blague,sketch,comedie,rire,mdr,prank,stand up,film,cinema,serie,extrait,scene,movie,series
# Long sources are expensive to encode; a 5:52 clip once held ffmpeg for over
# an hour. Unknown (0) durations are kept.
DISCOVER_MAX_DURATION_S=90
# 0 = control edit only. Measured 2026-11-09 at n=30: heavy 83% restricted vs
# control 78%, for ~10x the encode cost, so the heavy arm is retired.
TRANSFORM_VARIANT_RATIO=0
# LIVE growth-bot: joins 'follow train' lives and follows commenters
FOLLOW_DAILY_CAP=5
FOLLOW_MIN_GAP=120
FOLLOW_MAX_GAP=300
FOLLOW_KEYWORDS=follow train,f4f,follow for follow,grow your account,l4l,grow with me,engagement
POSTS_PER_DAY=1
MAX_POSTS_PER_DAY=3
PUBLISH_SLOTS=08:00,13:30,19:30
STAGE_ONLY=true
OVERLAY_ENABLED=true
OVERLAY_ACCOUNT=@yourhandle
OVERLAY_STYLE=bar
DATA_DIR=data
COOKIE_DIR=cookies
TZ=Africa/Kigali
